# Environment Configuration Template
ENVIRONMENT=development
LOG_LEVEL=INFO

# Data & Model Storage Paths
DATA_DIR=data
MODELS_DIR=models
REPORTS_DIR=reports

# GeoIP Databases (Local offline copies)
GEOIP_CITY_DB_PATH=data/external/geoip/GeoLite2-City.mmdb
GEOIP_ASN_DB_PATH=data/external/geoip/GeoLite2-ASN.mmdb

# Dashboard Service Port
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
