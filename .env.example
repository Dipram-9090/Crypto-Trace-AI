# Environment Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO

# Data & Model Storage Paths
DATA_DIR=data
MODELS_DIR=ml-models
REPORTS_DIR=reports

# Blockchain RPC Providers (Ethereum, Bitcoin, Solana, EVM)
ETH_RPC_URL=https://eth.llamarpc.com
BTC_RPC_URL=http://127.0.0.1:8332
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
ALCHEMY_API_KEY=your_alchemy_key_here
INFURA_API_KEY=your_infura_key_here
ETHERSCAN_API_KEY=your_etherscan_key_here

# Databases & Cache
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cryptotrace
MONGO_URI=mongodb://localhost:27017
REDIS_URL=redis://localhost:6379/0

# Security & Authentication
JWT_SECRET=super-secret-crypto-trace-jwt-key-32-chars-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# GeoIP Databases
GEOIP_CITY_DB_PATH=data/external/geoip/GeoLite2-City.mmdb
GEOIP_ASN_DB_PATH=data/external/geoip/GeoLite2-ASN.mmdb

# Server Ports
BACKEND_PORT=8000
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
